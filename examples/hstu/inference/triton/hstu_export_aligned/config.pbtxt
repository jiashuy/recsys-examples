# Triton Python-backend version of the non-KV-cache AOTI export path.
# The tensor contract intentionally matches inference_aoti/hstu_gr_ranking.
name: "hstu_export_aligned"
backend: "python"
max_batch_size: 0

input [
  {
    name: "INPUT__0"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "INPUT__1"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "INPUT__2"
    data_type: TYPE_INT64
    dims: [ -1 ]
  }
]

output [
  {
    name: "OUTPUT__0"
    data_type: TYPE_FP32
    dims: [ -1, 8 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

parameters {
  key: "HSTU_ROOT"
  value: {
    string_value: "/workspace/recsys-examples/examples/hstu"
  }
}

parameters {
  key: "HSTU_GIN_CONFIG_FILE"
  value: {
    string_value: "/workspace/recsys-examples/examples/hstu/inference/configs/kuairand_1k_inference_ranking.gin"
  }
}

parameters {
  key: "HSTU_CHECKPOINT_DIR"
  value: {
    string_value: "/workspace/recsys-examples/examples/hstu/ckpt/fused_kuairand_1k_ckpt"
  }
}

parameters {
  key: "HSTU_MAX_BATCH_SIZE"
  value: {
    string_value: "8"
  }
}

parameters {
  key: "FORCE_CPU_ONLY_INPUT_TENSORS"
  value: {
    string_value: "yes"
  }
}
